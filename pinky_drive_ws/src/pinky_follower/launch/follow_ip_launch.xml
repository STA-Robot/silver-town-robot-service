<?xml version='1.0' ?>

<launch>
    <arg name="robot_name" default="robot_1"/>
    <arg name="robot_ip" default="192.168.4.1"/>
    <arg name="robot_domain_id" default="32"/>


    <node pkg="pinky_follower" exec="followerNode">
        <param from="$(find-pkg-share pinky_follower)/config/follow_ip.yaml"/>
        <param name="robot_name" value="$(var robot_name)"/>
        <param name="robot_ip" value="$(var robot_ip)"/>
        <param name="robot_domain_id" value="$(var robot_domain_id)"/>
    </node>

</launch>
